# ============================================================
# CERTUS — Système de gestion de licences pour Experto
# ============================================================
# Copiez ce fichier vers .env et adaptez les valeurs.
# Ne commitez JAMAIS le fichier .env réel dans Git.
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
APP_NAME=Certus
APP_ENV=local                    # local | staging | production
APP_KEY=                         # Généré par : php artisan key:generate
APP_DEBUG=true                   # false en production
APP_URL=https://certus.expertosoft.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ------------------------------------------------------------
# LOGS
# ------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                  # debug | info | warning | error en production

# ------------------------------------------------------------
# BASE DE DONNÉES — MariaDB 10.11
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306                     # 3307 sur certains WAMP (vérifier avec SHOW VARIABLES LIKE 'port')
DB_DATABASE=certus_db
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------
# SESSION & CACHE
# ------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120             # en minutes
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=certus_

# ------------------------------------------------------------
# FILES & QUEUES
# ------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ------------------------------------------------------------
# REDIS (optionnel — remplace cache/session en production)
# ------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------
# MAIL
# ------------------------------------------------------------
MAIL_MAILER=log                  # smtp | sendmail | mailgun | log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@expertosoft.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------
# CERTUS — Notifications & Portail
# ------------------------------------------------------------
CERTUS_ADMIN_EMAIL="admin@expertosoft.com"   # Destinataire des alertes de piratage
CERTUS_PORTAL_URL="${APP_URL}/admin"          # Lien inclus dans les emails d'alerte

# ------------------------------------------------------------
# JWT AUTH — tymon/jwt-auth
# Générer avec : php artisan jwt:secret
# ------------------------------------------------------------
JWT_SECRET=                      # OBLIGATOIRE — clé de 64 caractères
JWT_TTL=60                       # Durée du token en minutes (60 = 1h)
JWT_REFRESH_TTL=20160            # Durée de rafraîchissement en minutes (14 jours)

# ------------------------------------------------------------
# AWS S3 (optionnel — stockage fichiers de licence)
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------
# VITE (front-end assets)
# ------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
